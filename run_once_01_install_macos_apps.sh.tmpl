brew "jq"
brew "m-cli"
brew "mas"
brew "pinentry-mac"
brew "speedtest"
brew "trash"
brew "wget"
brew "wifi-password"
{{-   if eq .minimalinstall "false" }}
{{-     if eq .workconfig "true" }}
brew "gh"
brew "glab"
brew "lazygit"
brew "vercel-cli"
{{-     end }}
brew "aria2"
brew "btop"
brew "ffmpeg"
brew "go"
brew "httpie"
brew "irssi"
brew "neovim"
brew "newsboat"
brew "nmap"
brew "openssl"
brew "peco"
brew "pnpm"
brew "pyenv"
brew "uv"
