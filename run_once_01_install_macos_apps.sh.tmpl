cask "orbstack"
cask "postman"
cask "processing"
cask "sequel-ace"
cask "slack"
cask "utm"
{{-     if (ne .chezmoi.arch "arm64") }}
cask "virtualbox"
{{-     end }}
cask "visual-studio-code"
