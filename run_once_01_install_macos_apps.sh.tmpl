brew "tmux"
brew "tmuxinator"
brew "topgrade"
brew "watch"
brew "weechat"
brew "xxh"
brew "yt-dlp"
brew "zoxide"
{{-   end }}

##### casks #####
cask "alfred"
cask "brave-browser"
cask "dropbox"
cask "google-chrome"
cask "iina"
cask "keka"
cask "kitty"
cask "moom"
cask "notion"
cask "pearcleaner"
cask "protonvpn"
cask "quicklook-video"
cask "spotify"
cask "tailscale-app"
{{-   if eq .minimalinstall "false" }}
{{-     if eq .workconfig "true" }}
cask "studio-3t"
