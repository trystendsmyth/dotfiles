# GNU coreutils instead of outdated mac os defaults
brew "coreutils"
brew "moreutils"
# newer version of bash
brew "bash"
brew "bash-completion@2"
# newer version of zsh
brew "zsh"
brew "zsh-completions"

brew "bat"
brew "bitwarden-cli"
brew "curl"
brew "dashlane-cli"
brew "direnv"
brew "dockutil"
brew "duti"
brew "eza"
brew "fd"
brew "fzf"
brew "git"
brew "git-delta"
