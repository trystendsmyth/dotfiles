# Shared login environment for every shell: sh/bash read it directly, zsh via
# ~/.zprofile, and Linux desktop sessions export it to everything they launch.
# Keep it POSIX; shell-specific setup lives in ~/.zshrc and ~/.bashrc.

# set paths
export BREW_PATH="/opt/homebrew/sbin:/opt/homebrew/bin:/usr/local/sbin:/usr/local/bin"
export PATH="$BREW_PATH:$PATH:$HOME/bin:$HOME/.local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
{{- if (eq .chezmoi.os "linux") }}
if [ -d /home/linuxbrew/.linuxbrew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

# set default editor; GUI editor when available (git, chezmoi edit)
export EDITOR='nvim'
if command -v code >/dev/null 2>&1; then
    export VISUAL='code -w -n'
fi

# utf-8 all the things
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# set colors
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad
export LS_COLORS="di=1;34:ln=1;35:so=1;31:pi=1;33:ex=1;32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"

# set default blocksize for ls, df, du
export BLOCKSIZE=1k

# Lets .zshrc/.bashrc tell whether this file was loaded for the session
export DOTFILES_PROFILE=1
