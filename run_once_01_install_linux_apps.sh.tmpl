#!/bin/bash
{{ if (eq .chezmoi.os "linux") }}
{{- /* Treat both 32-bit and 64-bit ARM (e.g. Raspberry Pi) as "arm". */}}
{{- $isArm := or (eq .chezmoi.arch "arm") (eq .chezmoi.arch "arm64") }}
{{- /* Arch and Arch derivatives (Manjaro, EndeavourOS, ...). */}}
{{- $isArch := or (eq .chezmoi.osRelease.id "arch") (contains "arch" (index .chezmoi.osRelease "idLike" | default "")) }}
{{- /* Fedora and derivatives (Nobara, RHEL clones, ...). */}}
{{- $isFedora := or (eq .chezmoi.osRelease.id "fedora") (contains "fedora" (index .chezmoi.osRelease "idLike" | default "")) }}
{{- /* Kitty needs a GPU; fall back to guake on ARM boards. */}}
{{- $terminal := "kitty" }}
{{- if $isArm }}{{ $terminal = "guake" }}{{ end }}
{{- $nerdFontsVersion := "v3.5.1" }}
{{- /* LazyVim's minimum Neovim, and nvim-treesitter's minimum tree-sitter CLI. */}}
{{- $nvimMin := "0.11.2" }}
{{- $treeSitterMin := "0.26.1" }}

# Latest release tag of a GitHub repo, from the /releases/latest redirect (no API rate limit).
gh_latest_tag() {
    curl -fsSLI --retry 3 --retry-all-errors -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest" | sed 's#.*/tag/##'
}

# curl that survives transient network errors
fetch() {
    curl -fsSL --retry 3 --retry-all-errors "$@"
}

# version_ge A B: true if version A >= B
version_ge() {
    [ "$(printf '%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]
}

# Containers and some minimal installs run without systemd.
has_systemd() {
    [ -d /run/systemd/system ]
}

##### packages #####
{{- if $isArch }}
# Install what the repos have and report the rest (tmuxinator and topgrade are AUR-only).
pacman_install() {
    local available=() missing=() pkg
    for pkg in "$@"; do
        if pacman -Si "$pkg" &>/dev/null || pacman -Sg "$pkg" &>/dev/null; then
            available+=("$pkg")
        else
            missing+=("$pkg")
        fi
    done
    sudo pacman -S --needed --noconfirm "${available[@]}"
    if [ ${#missing[@]} -gt 0 ]; then
        echo "Not in the Arch repos, skipped: ${missing[*]}"
    fi
}

pacman_install \
    aria2 \
    base-devel \
    bat \
    coreutils \
    curl \
    direnv \
    eza \
    fd \
    ffmpeg \
    file \
    fontconfig \
    fzf \
    git \
    git-delta \
    gnupg \
    htop \
    jq \
    {{ $terminal }} \
    lazygit \
    neovim \
    procps-ng \
    ripgrep \
    starship \
    tailscale \
    tmux \
    tree-sitter-cli \
    unzip \
    wget \
    wl-clipboard \
    xclip \
    yt-dlp \
    zoxide \
    zsh
has_systemd && sudo systemctl enable --now tailscaled
{{- else if $isFedora }}
# Install what this release has and report the rest (RHEL clones lack some without EPEL).
if dnf --version 2>/dev/null | grep -q dnf5; then
    dnf_skip="--skip-unavailable"
else
    dnf_skip="--setopt=strict=0"
fi
sudo dnf install -y $dnf_skip \
    aria2 \
    bat \
    coreutils \
    curl \
    direnv \
    eza \
    fd-find \
    ffmpeg-free \
    file \
    fontconfig \
    fzf \
    gcc \
    gcc-c++ \
    git \
    git-delta \
    gnupg2 \
    htop \
    jq \
    {{ $terminal }} \
    make \
    neovim \
    pinentry-gnome3 \
    procps-ng \
    ripgrep \
    tailscale \
    tmux \
    tree-sitter-cli \
    unzip \
    wget \
    wl-clipboard \
    xclip \
{{- if $isArm }}
    yt-dlp \
{{- end }}
    zoxide \
    zsh
command -v tailscale &>/dev/null && has_systemd && sudo systemctl enable --now tailscaled
{{- else }}
# Install every package that this release knows about and report the rest,
# so one missing package on an older Debian/Ubuntu does not abort the lot.
apt_install() {
    local available=() missing=() pkg
    for pkg in "$@"; do
        if apt-cache show "$pkg" &>/dev/null; then
            available+=("$pkg")
        else
            missing+=("$pkg")
        fi
    done
    sudo apt install -y "${available[@]}"
    if [ ${#missing[@]} -gt 0 ]; then
        echo "Not available via apt on this release, skipped: ${missing[*]}"
    fi
}

sudo apt update
apt_install \
    aria2 \
    bat \
    build-essential \
    coreutils \
    curl \
    direnv \
    fd-find \
    ffmpeg \
    file \
    fontconfig \
    fzf \
    git \
    git-delta \
    gnupg \
    htop \
    jq \
    {{ $terminal }} \
    lazygit \
    neovim \
    pinentry-gnome3 \
    procps \
    ripgrep \
    starship \
    tmux \
    tmuxinator \
    unzip \
    wget \
    wl-clipboard \
    xclip \
{{- if $isArm }}
    yt-dlp \
{{- end }}
    zoxide \
    zsh

# Debian renames these binaries to avoid clashes; expose them under their upstream names.
command -v batcat &>/dev/null && ! command -v bat &>/dev/null && sudo ln -sf "$(command -v batcat)" /usr/local/bin/bat
command -v fdfind &>/dev/null && ! command -v fd  &>/dev/null && sudo ln -sf "$(command -v fdfind)" /usr/local/bin/fd

# eza is in Debian 13+ / Ubuntu 24.10+; older releases need the upstream repo.
if ! apt-cache show eza &>/dev/null; then
    sudo mkdir -p /etc/apt/keyrings
    wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc \
        | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
    echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" \
        | sudo tee /etc/apt/sources.list.d/gierens.list
    sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
    sudo apt update
fi
sudo apt install -y eza
sudo apt clean
{{- end }}

##### tools the distro lacks or ships too old (each step skips when it isn't needed) #####

# Tailscale is not in the Debian/Ubuntu repos; the official script adds its repo and enables the service.
if ! command -v tailscale &>/dev/null && has_systemd; then
    fetch https://tailscale.com/install.sh | sh
fi

# topgrade is not packaged for Debian/Ubuntu or Fedora, and is AUR-only on Arch; install the prebuilt release binary.
# (Compiling via cargo takes minutes, and `sudo cargo install` lands in root's PATH.)
if ! command -v topgrade &>/dev/null; then
    case "$(uname -m)" in
        x86_64)  topgrade_target="x86_64-unknown-linux-gnu" ;;
        aarch64) topgrade_target="aarch64-unknown-linux-gnu" ;;
        armv7l)  topgrade_target="armv7-unknown-linux-gnueabihf" ;;
        *)       topgrade_target="" ;;
    esac
    if [ -n "$topgrade_target" ]; then
        topgrade_tag="$(gh_latest_tag topgrade-rs/topgrade)"
        topgrade_tmp="$(mktemp -d)"
        fetch "https://github.com/topgrade-rs/topgrade/releases/download/${topgrade_tag}/topgrade-${topgrade_tag}-${topgrade_target}.tar.gz" \
            | tar -xz -C "$topgrade_tmp"
        sudo install -m 755 "$topgrade_tmp/topgrade" /usr/local/bin/topgrade
        rm -rf "$topgrade_tmp"
    else
        echo "No prebuilt topgrade binary for $(uname -m); skipping."
    fi
fi

# LazyVim needs Neovim {{ $nvimMin }}+, newer than Ubuntu 24.04 / Debian 13 ship. Use the official
# release in /opt/nvim when the distro's is too old.
if ! version_ge "$(nvim --version 2>/dev/null | sed -n '1s/^NVIM v//p')" {{ $nvimMin }}; then
    case "$(uname -m)" in
        x86_64)  nvim_asset="nvim-linux-x86_64" ;;
        aarch64) nvim_asset="nvim-linux-arm64" ;;
        *)       nvim_asset="" ;;
    esac
    if [ -n "$nvim_asset" ]; then
        nvim_tmp="$(mktemp -d)"
        fetch "https://github.com/neovim/neovim/releases/latest/download/${nvim_asset}.tar.gz" \
            | tar -xz -C "$nvim_tmp"
        sudo rm -rf /opt/nvim
        sudo mv "$nvim_tmp/$nvim_asset" /opt/nvim
        sudo ln -sf /opt/nvim/bin/nvim /usr/local/bin/nvim
        rm -rf "$nvim_tmp"
    else
        echo "No Neovim release build for $(uname -m); LazyVim needs Neovim {{ $nvimMin }}+."
    fi
fi

# nvim-treesitter (used by LazyVim) builds parsers with the tree-sitter CLI {{ $treeSitterMin }}+;
# distro packages are older except on recent Fedora.
if ! version_ge "$(tree-sitter --version 2>/dev/null | awk '{print $2}')" {{ $treeSitterMin }}; then
    case "$(uname -m)" in
        x86_64)  ts_asset="tree-sitter-linux-x64" ;;
        aarch64) ts_asset="tree-sitter-linux-arm64" ;;
        *)       ts_asset="" ;;
    esac
    if [ -n "$ts_asset" ]; then
        ts_tmp="$(mktemp -d)"
        fetch "https://github.com/tree-sitter/tree-sitter/releases/latest/download/${ts_asset}.gz" \
            | gunzip > "$ts_tmp/tree-sitter"
        sudo install -m 755 "$ts_tmp/tree-sitter" /usr/local/bin/tree-sitter
        rm -rf "$ts_tmp"
    else
        echo "No tree-sitter CLI build for $(uname -m); skipping."
    fi
fi

# lazygit is packaged on Debian 13 but not Ubuntu 24.04 or Fedora.
if ! command -v lazygit &>/dev/null; then
    case "$(uname -m)" in
        x86_64)        lazygit_arch="x86_64" ;;
        aarch64)       lazygit_arch="arm64" ;;
        armv7l|armv6l) lazygit_arch="armv6" ;;
        *)             lazygit_arch="" ;;
    esac
    if [ -n "$lazygit_arch" ]; then
        lazygit_tag="$(gh_latest_tag jesseduffield/lazygit)"
        lazygit_tmp="$(mktemp -d)"
        fetch "https://github.com/jesseduffield/lazygit/releases/download/${lazygit_tag}/lazygit_${lazygit_tag#v}_linux_${lazygit_arch}.tar.gz" \
            | tar -xz -C "$lazygit_tmp" lazygit
        sudo install -m 755 "$lazygit_tmp/lazygit" /usr/local/bin/lazygit
        rm -rf "$lazygit_tmp"
    else
        echo "No lazygit build for $(uname -m); skipping."
    fi
fi

# Starship is packaged on Debian 13 but not Ubuntu 24.04 or Fedora; its installer uses sudo itself.
if ! command -v starship &>/dev/null; then
    fetch https://starship.rs/install.sh | sh -s -- -y -b /usr/local/bin
fi

{{ if $isArm }}
##### guake config #####
guake --restore-preferences ~/.config/guake/guake.conf
{{- else if not (env "CI") }}
##### homebrew #####
# Homebrew on Linux only supports x86_64. CI skips it: it is slow and not what CI tests.
if ! command -v brew &>/dev/null; then
    NONINTERACTIVE=1 /bin/bash -c "$(fetch https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    brew analytics off
else
    brew update --verbose
    brew upgrade --verbose
    brew cleanup -s
fi
{{- if not $isArch }}

# Distro yt-dlp lags behind YouTube changes; brew keeps it current via topgrade.
brew install yt-dlp
{{- end }}
{{- if or $isFedora $isArch }}

# Not packaged for Fedora, and AUR-only on Arch.
brew install tmuxinator
{{- end }}
{{- end }}

##### fonts #####
# Same families as the macOS Brewfile: Hack Nerd Font, IBM Plex, Source Code Pro.
# Nerd Fonts v3 moved many glyph codepoints, and both eza --icons and current
# kitty themes expect v3.
font_dir="$HOME/.local/share/fonts"
font_tmp="$(mktemp -d)"
mkdir -p "$font_dir"
for font in Hack IBMPlexMono SourceCodePro; do
    wget -qO "$font_tmp/$font.zip" "https://github.com/ryanoasis/nerd-fonts/releases/download/{{ $nerdFontsVersion }}/$font.zip" \
        && unzip -oq "$font_tmp/$font.zip" -d "$font_dir/$font" -x 'LICENSE*' 'README*' \
        || echo "Failed to install $font Nerd Font"
done
rm -rf "$font_tmp"

fc-cache -f
{{ end }}
