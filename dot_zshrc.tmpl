# Enable Zsh profiler
zmodload zsh/zprof
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi

# Environment (PATH, EDITOR, locale, colors) comes from ~/.profile via ~/.zprofile
# or the login session; load it here if neither did (e.g. before re-login).
[[ -n $DOTFILES_PROFILE ]] || emulate sh -c '. ~/.profile'
# Drop the duplicates nested login shells (e.g. tmux panes) add to PATH.
typeset -U path

# gpg
export GPG_TTY=$(tty)

# NVM plugin settings
export NVM_AUTO_USE=true        # required by the lazy auto-load below
export NVM_COMPLETION=true
export NVM_LAZY_LOAD=true

# Lazy-load nvm + apply .nvmrc on first entry into a project dir.
# (NVM_LAZY_LOAD defers nvm.sh, which otherwise breaks zsh-nvm's auto-use.)
export NVM_LAZY_AUTO_DIR=("$HOME/Projects")
_nvm_lazy_autoload() {
  [[ "$(type node 2>/dev/null)" == *'shell function'* ]] || return  # already loaded
  local d
  for d in $NVM_LAZY_AUTO_DIR; do
    if [[ "$PWD/" == "$d"/* ]]; then
      print 'Activating nvm...'
      node --version >/dev/null 2>&1   # trigger lazy load
      cd "$PWD"                         # re-fire chpwd -> apply .nvmrc
      return
    fi
  done
}
if [[ "$NVM_LAZY_LOAD" == true ]]; then
  autoload -U add-zsh-hook
  add-zsh-hook precmd _nvm_lazy_autoload
fi

# Ignores all one-word commands for more efficient bash history searching
export HISTIGNORE=?
# Long history without duplicates, flush after every command
export HISTCONTROL=ignoreboth:erasedups
export HISTSIZE=1000000
# zsh requires SAVEHIST (and a HISTFILE) to actually persist history to disk
export SAVEHIST=1000000
export HISTFILE=~/.zsh_history

# When the shell exits, append to the history file instead of overwriting it
setopt appendhistory
setopt sharehistory
setopt incappendhistory
setopt hist_ignore_all_dups
setopt hist_find_no_dups
setopt hist_save_no_dups
setopt hist_reduce_blanks
setopt hist_beep

bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward

# Let Chezmoi handle external updates
DISABLE_AUTO_UPDATE="true"

# directory specific .envrc files
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

# Zsh completion for brew
(( $+commands[brew] )) && FPATH=$(brew --prefix)/share/zsh/site-functions:$FPATH

# Remote hosts rarely have kitty's terminfo
[[ "$TERM" == xterm-kitty ]] && alias ssh='TERM=xterm-256color ssh'

# Set "Oh My Zsh" plugins
plugins=(zsh-autosuggestions zsh-history-substring-search zsh-nvm zsh-syntax-highlighting tmuxinator fzf zoxide)

# Zsh theme
source ~/.zsh_theme

# Aliases are managed here
source ~/.shell_aliases

# Functions are managed here
source ~/.shell_functions

# Work related additions
test -f ~/.work_profile && source ~/.work_profile