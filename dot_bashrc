# Interactive bash only
[[ $- == *i* ]] || return

# Load ~/.profile if neither a login shell nor the session already did
[ -n "$DOTFILES_PROFILE" ] || . ~/.profile

# change prompt (fallback when Starship isn't installed)
PS1="\[\033[36m\]\u\[\033[m\]@\[\033[32m\]\h:\[\033[33;1m\]\w\[\033[m\]\$ "

# gpg
export GPG_TTY=$(tty)

# Ignores all one-word commands for more efficient bash history searching
HISTIGNORE=?
# Long history without duplicates
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=1000000

# When the shell exits, append to the history file instead of overwriting it
shopt -s histappend

# Bash completion: Homebrew's bash-completion@2, else the distro's
for f in "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh" \
         /usr/local/etc/profile.d/bash_completion.sh \
         /usr/share/bash-completion/bash_completion; do
    [ -r "$f" ] && . "$f" && break
done
unset f

# nvm (zsh uses the zsh-nvm plugin instead)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# mise for per-project tools; nvm and pyenv still manage Node and Python
command -v mise &>/dev/null && eval "$(mise activate bash)"

# directory specific .envrc files
command -v direnv &>/dev/null && eval "$(direnv hook bash)"

# Aliases are managed here
. ~/.shell_aliases

# Functions are managed here
. ~/.shell_functions

# Work related additions
[ -f ~/.work_profile ] && . ~/.work_profile

# Starship prompt, same ~/.config/starship.toml as zsh. Last, so that hooks added to
# PROMPT_COMMAND above (direnv) run inside Starship's and don't hide the exit status.
if command -v starship &>/dev/null; then
    . ~/.config/starship/prompt-state.sh
    _sp_bash_precmd() {
        local dur=
        # Starship measures the duration after this hook runs, so take it the same way here.
        if [ -n "${STARSHIP_START_TIME-}" ] && [ -n "${EPOCHREALTIME-}" ]; then
            dur=$(( ${EPOCHREALTIME/[.,]/} / 1000 - STARSHIP_START_TIME ))
        fi
        _sp_prompt_state "$dur" "${NUM_JOBS:-0}" "$STARSHIP_CMD_STATUS"
    }
    starship_precmd_user_func=_sp_bash_precmd
    eval "$(starship init bash)"
fi
