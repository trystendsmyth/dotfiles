#!/bin/sh
# Copy stdin to the Linux clipboard (tmux copy mode, see ~/.tmux.conf). Decided at run time
# because one machine can run X11 or Wayland sessions.
if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
elif command -v xclip >/dev/null 2>&1; then
    exec xclip -in -selection clipboard
fi
# No clipboard tool: tmux's OSC 52 (set-clipboard) still reaches the terminal.
cat >/dev/null
