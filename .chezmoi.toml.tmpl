{{- $email := promptString "Email" -}}
{{- $fullname := promptString "Full name" -}}
{{- $gituser := promptString "Git username" -}}
{{- $minimalinstall := promptBool "Minimal install (y/n)" -}}
{{- $workconfig := promptBool "Work Computer (y/n)" -}}
{{- $signingkey := promptString "GPG signing key ID (blank to disable commit signing)" -}}
{{- $secrets := eq (env "SECRETS") "true" -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    email = {{ $email | quote }}
    fullname = {{ $fullname | quote }}
    gituser = {{ $gituser | quote }}
    minimalinstall = {{ $minimalinstall | quote }}
    workconfig = {{ $workconfig | quote }}
    signingkey = {{ $signingkey | quote }}
    secrets = {{ $secrets | quote }}
{{- if $secrets }}

[bitwarden]
    unlock = "auto"

# Installs and logs in to the Bitwarden CLI before templates are rendered.
[hooks.read-source-state.pre]
    command = "sh"
    args = [{{ joinPath .chezmoi.sourceDir ".install-password-manager.sh" | quote }}]
{{- end }}
