export ZSH=~/.oh-my-zsh
# ~/.oh-my-zsh is an exact chezmoi external, so keep oh-my-zsh's cache out of it
export ZSH_CACHE_DIR=~/.cache/oh-my-zsh

# oh-my-zsh is kept for its plugins; the prompt comes from Starship (~/.config/starship.toml).
ZSH_THEME=""

source $ZSH/oh-my-zsh.sh

if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
  source ~/.config/starship/prompt-state.sh
  # Added after starship's own precmd hook, so its duration, job count and status are set.
  _sp_precmd() { _sp_prompt_state "$STARSHIP_DURATION" "$STARSHIP_JOBS_COUNT" "$STARSHIP_CMD_STATUS"; }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _sp_precmd
fi
